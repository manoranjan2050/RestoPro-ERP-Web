# Production .env — copy to ~/restopro-app/.env on the server, fill the <…> parts, chmod 600.
# Never commit the real file.

APP_NAME="RestoPro ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.example.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# MySQL / MariaDB database (on Hostinger: hPanel → Databases; names get your account prefix, e.g. u123456789_)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Optional: a mailbox for outgoing mail later
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First owner account — used once by `php artisan db:seed --force`, then remove ADMIN_PASSWORD from this file.
ADMIN_NAME="Owner"
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=
