# Copy to deploy/deploy.env (gitignored) and fill in your server. Read by deploy/deploy.sh.
DEPLOY_HOST="user@your-server-ip"
DEPLOY_PORT=22                          # Hostinger uses 65002
DEPLOY_KEY="$HOME/.ssh/id_ed25519"      # private key whose .pub is added to the server
APP_DIR="restopro-app"                  # app folder in the home directory (not web reachable)
WEB_DIR="public_html/erp"               # folder your (sub)domain serves; becomes a symlink to APP_DIR/public
                                        # Hostinger addon domains: domains/example.com/public_html/erp
